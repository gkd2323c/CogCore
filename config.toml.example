# CogCore 配置文件模板
# 复制为 config.toml 后按需修改：
#   cp config.toml.example config.toml
#
# 注意：config.toml 已加入 .gitignore，不会上传到 GitHub。
# 敏感信息（api_key 等）只填在 config.toml 中。

[llm]
# API 协议类型：openai | ollama
#   openai = 标准 OpenAI /v1/chat/completions 协议（Ollama/vLLM 也兼容）
#   ollama = Ollama 原生协议
api_type = "openai"

# API 端点
#   本地 Ollama:      http://localhost:11434/v1
#   OpenAI:           https://api.openai.com/v1
#   其他兼容服务:      http://<host>:<port>/v1
endpoint = "http://localhost:11434/v1"

# API Key（本地服务留空，远程服务必填）
# api_key = "sk-..."

# 模型名称
#   本地 Ollama:  qwen3.5:latest / llama3.2:3b 等
#   OpenAI:      gpt-4o / gpt-4o-mini 等
model = "qwen3.5:latest"

# 生成参数
temperature = 0.7
max_tokens = 4096
timeout = 60

# 对话循环最大轮数（防止死循环）
max_turns = 10

# 是否启用流式输出
stream = false

# M3.2: 多 LLM Provider (fallback 轮转)
# 留空时使用上面的 endpoint/model/api_key 单 provider 模式
# providers 按 priority 排序（数字越小越优先）
#
# [[llm.providers]]
# name = "deepseek"
# endpoint = "https://api.deepseek.com/v1"
# api_key = "sk-..."
# model = "deepseek-chat"
# priority = 1
# enabled = true
#
# [[llm.providers]]
# name = "ollama_local"
# endpoint = "http://127.0.0.1:11434/v1"
# model = "qwen3.5:9b"
# priority = 2
# enabled = true

# Fallback 行为
fallback_max_attempts = 3
fallback_cooldown_sec = 30

[persistence]
# 持久化后端：memory | sqlite
backend = "memory"

# SQLite 路径（backend=sqlite 时生效，不需要 Docker）
# sqlite_path = "cogcore_state.db"

[runtime]
# 日志级别：DEBUG | INFO | WARNING | ERROR
log_level = "INFO"

# 默认模式：full_silent | ap_agency | reinforced_agency
mode = "full_silent"

[service]
# 后台 tick 间隔（秒），0=不自动 tick
tick_interval = 60

# 自动写日记间隔（ticks），0=禁用
diary_interval = 100

# 状态报告间隔（ticks）
report_interval = 500

# 数据目录
data_dir = "cogcore_data"
